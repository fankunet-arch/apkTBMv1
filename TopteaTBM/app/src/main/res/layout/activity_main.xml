<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- MAC ID 卡片 (顶部显著展示) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMacId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1C1C1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dark Matrix Terminal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E5E5E5" />

            <TextView
                android:id="@+id/tvMacId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MAC: Loading..."
                android:textSize="14sp"
                android:textColor="#8E8E93"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="初始化中..."
                android:textSize="12sp"
                android:textColor="#8E8E93" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 音量警告卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardVolumeWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FF3B30"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardMacId">

        <TextView
            android:id="@+id/tvVolumeWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="⚠️ 警告：设备已静音"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center" />
    </androidx.cardview.widget.CardView>

    <!-- 日志区域标题 -->
    <TextView
        android:id="@+id/tvLogsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="运行日志 (Runtime Logs)"
        android:layout_marginTop="16dp"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="#8E8E93"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardVolumeWarning" />

    <!-- 日志滚动区域 -->
    <ScrollView
        android:id="@+id/scrollLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#1C1C1E"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogsLabel"
        app:layout_constraintBottom_toTopOf="@id/cardNowPlaying"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for events..."
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="#E5E5E5" />
    </ScrollView>

    <!-- Now Playing 底部常驻卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardNowPlaying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1C1C1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now Playing"
                android:textSize="10sp"
                android:textColor="#8E8E93"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNowPlaying"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🎵 等待播放..."
                android:textSize="14sp"
                android:textColor="#E5E5E5"
                android:fontFamily="monospace" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
